## sql database schema for small service business

CREATE TABLE leads (id SERIAL PRIMARY KEY, customer_id INT, contractor_id INT, date_created DATE, status VARCHAR(255), notes TEXT, FOREIGN KEY (customer_id) REFERENCES customers(id), FOREIGN KEY (contractor_id) REFERENCES contractors(id));
CREATE TABLE customers (id SERIAL PRIMARY KEY, name VARCHAR(255), email VARCHAR(255), phone VARCHAR(20), address TEXT);
CREATE TABLE contractors (id SERIAL PRIMARY KEY, name VARCHAR(255), email VARCHAR(255), phone VARCHAR(20), specialty VARCHAR(255));
CREATE TABLE estimates (id SERIAL PRIMARY KEY, lead_id INT, date_created DATE, amount NUMERIC(10, 2), status VARCHAR(255), FOREIGN KEY (lead_id) REFERENCES leads(id));
CREATE TABLE invoices (id SERIAL PRIMARY KEY, estimate_id INT, date_created DATE, amount NUMERIC(10, 2), status VARCHAR(255), FOREIGN KEY (estimate_id) REFERENCES estimates(id));
CREATE TABLE payments (id SERIAL PRIMARY KEY, invoice_id INT, date_paid DATE, amount NUMERIC(10, 2), FOREIGN KEY (invoice_id) REFERENCES invoices(id));
CREATE TABLE jobs (id SERIAL PRIMARY KEY, lead_id INT, estimated_start_date DATE, actual_start_date DATE, estimated_end_date DATE, actual_end_date DATE, status VARCHAR(255), FOREIGN KEY (lead_id) REFERENCES leads(id));
CREATE TABLE company_assets (id SERIAL PRIMARY KEY, name VARCHAR(255), type VARCHAR(255), purchase_date DATE, purchase_cost NUMERIC(10, 2));
CREATE TABLE supplies_inventory (id SERIAL PRIMARY KEY, name VARCHAR(255), quantity INT, unit_cost NUMERIC(10, 2));
CREATE TABLE cash_flow (id SERIAL PRIMARY KEY, type VARCHAR(255), date DATE, amount NUMERIC(10, 2), description TEXT);


